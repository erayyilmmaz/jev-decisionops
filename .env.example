# Local development only. Do not put real credentials in this file.
DECISIONOPS_ENV=development
DATABASE_URL=postgresql+asyncpg://decisionops:decisionops_dev_only@localhost:5432/decisionops
ALEMBIC_DATABASE_URL=postgresql+psycopg://decisionops:decisionops_dev_only@localhost:5432/decisionops
TYPESAFE_API_KEY=
